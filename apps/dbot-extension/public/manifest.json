{
  "manifest_version": 3,
  "name": "DBot — Job Assistant",
  "version": "0.5.0",
  "minimum_chrome_version": "114",
  "description": "Compare job postings with your profile in a persistent browser side panel.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "http://127.0.0.1:5080/*",
    "https://*.onrender.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open DBot Side Panel"
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}
